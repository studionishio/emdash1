{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdash1",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "studionishio-db",
			"database_id": "acac05af-8bcb-4a9f-b7d1-76e724ece559"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media"
		}
	],
	"triggers": {
		"crons": ["* * * * *"]
	}
}
